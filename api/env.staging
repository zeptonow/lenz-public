# OpenReplay Python API - Staging Environment
# Copy relevant values to .env or mount as env file

# ---- PostgreSQL (your existing Postgres) ----
pg_host=your-postgres-host
pg_port=5432
pg_dbname=openreplay
pg_user=openreplay
pg_password=changeme
PG_MAXCONN=20
PG_MINCONN=8
PG_POOL=true
PG_TIMEOUT=30
PG_RETRY_INTERVAL=2
PG_RETRY_MAX=20

# ---- Redis (your existing Redis) ----
REDIS_STRING=redis://your-redis-host:6379

# ---- ClickHouse (DISABLED for now) ----
CH_ENABLED=false
# Dummy values - not used when CH_ENABLED=false
ch_host=localhost
ch_port=9000
ch_port_http=8123

# ---- S3 (real AWS S3, not MinIO) ----
# Leave S3_HOST empty for real S3
S3_HOST=
S3_KEY=
S3_SECRET=
S3_DISABLE_SSL_VERIFY=false
sessions_bucket=mobs
sessions_region=ap-south-1
sourcemaps_bucket=sourcemaps
js_cache_bucket=sessions-assets
IOS_VIDEO_BUCKET=mobs

# ---- Kafka ----
KAFKA_SERVERS=kafka-broker:9092
KAFKA_USE_SSL=false

# ---- Application ----
LISTEN_PORT=8000
LOGLEVEL=WARNING
S_LOGLEVEL=warning
PYTHONUNBUFFERED=1
TZ=UTC
STAGE=staging
APP_NAME=chalice

# ---- JWT ----
JWT_SECRET=changeme-jwt-secret
JWT_ALGORITHM=HS512
JWT_EXPIRATION=86400
JWT_REFRESH_EXPIRATION=604800
JWT_REFRESH_SECRET=changeme-jwt-refresh
JWT_SPOT_SECRET=changeme-jwt-spot-secret
JWT_SPOT_EXPIRATION=3600
JWT_SPOT_REFRESH_SECRET=changeme-jwt-spot-refresh
JWT_SPOT_REFRESH_EXPIRATION=604800
JWT_ISSUER=OpenReplay-oss
ASSIST_JWT_SECRET=changeme-assist-jwt

# ---- Feature Flags ----
PRESIGNED_URL_EXPIRATION=3600
PRIVATE_ENDPOINTS=false
EXP_CH_DRIVER=false
EXP_AUTOCOMPLETE=false
EXP_ALERTS=false
EXP_ERRORS_SEARCH=false
EXP_METRICS=false
EXP_SESSIONS_SEARCH=false
EXP_EVENTS=false

# ---- Internal Service URLs ----
sourcemaps_reader=http://localhost:9000/sourcemaps/{}/sourcemaps
ASSIST_URL=http://localhost:9001/assist/%s
SITE_URL=https://your-staging-domain.com
